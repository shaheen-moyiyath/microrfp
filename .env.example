# MicroRFP Environment Configuration

# Primary AI Provider: Google Gemini API (Get at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Alternative / Fallback AI Provider: Groq Cloud (Free Tier) (Get at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Preferred Groq model (defaults to llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
